<section class="gift-guide-banner">

  <!-- TOP BAR -->
  <div class="gg-topbar">
    <span class="gg-topbar__logo">{{ section.settings.logo_text }}</span>
    <span class="gg-topbar__tagline">{{ section.settings.tagline_text }}</span>
    <a href="{{ section.settings.choose_gift_link }}" class="gg-topbar__btn">
      {{ section.settings.choose_gift_text }} →
    </a>
  </div>

  <!-- DESKTOP + TABLET -->
  <div class="gg-hero gg-hero--desktop">
    {% if section.settings.bg_image %}
      <img 
  src="{{ section.settings.bg_image | image_url: width: 1800 }}" 
  alt="Banner Background" 
  class="gg-hero__bg-img"
  width="1800"
  height="1000"
>
    {% endif %}

    <div class="gg-hero__content">
      <h1 class="gg-hero__title">{{ section.settings.title }}</h1>
      <p class="gg-hero__desc">{{ section.settings.description }}</p>
      <a href="{{ section.settings.button_link }}" class="gg-hero__btn">
        {{ section.settings.button_text }} →
      </a>
    </div>
  </div>

  <!-- MOBILE -->
  <div class="gg-hero gg-hero--mobile">

    <div class="gg-hero__top-text">
      <h1 class="gg-hero__title">{{ section.settings.title }}</h1>
      <p class="gg-hero__desc">{{ section.settings.description }}</p>
    </div>

    <div class="gg-hero__image-wrap">
      {% if section.settings.bg_image %}
        <img 
  src="{{ section.settings.bg_image | image_url: width: 1800 }}" 
  alt="Banner Background" 
  class="gg-hero__bg-img"
  width="1800"
  height="1000">
      {% endif %}

      <div class="gg-hero__btn-overlay">
        <a href="{{ section.settings.button_link }}" class="gg-hero__btn">
          {{ section.settings.button_text }}
        </a>
      </div>
    </div>

  </div>

  <!-- BOTTOM TEXT -->
  <div class="gg-bottom">
    <p>{{ section.settings.bottom_text }}</p>
  </div>

</section>

<style>

/* RESET */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.gift-guide-banner {
  width: 100%;
  background: #fff;
  font-family: Arial, sans-serif;
}

/* TOP BAR */
.gg-topbar {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 14px 40px;
}

.gg-topbar__logo {
  font-weight: bold;
  font-size: 13px;
}

.gg-topbar__tagline {
  text-align: center;
  font-size: 13px;
}

.gg-topbar__btn {
  justify-self: end;
  background: #FFD700;
  padding: 10px 18px;
  font-size: 13px;
  font-weight: bold;
  text-decoration: none;
  color: #000;
  transition: 0.3s;
}

.gg-topbar__btn:hover {
  letter-spacing: 2px;
}

/* DESKTOP */
.gg-hero--desktop {
  position: relative;
  height: 520px;
  display: block;
}

.gg-hero--mobile {
  display: none;
}

.gg-hero__bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.gg-hero__content {
  position: absolute;
  bottom: 50px;
  left: 40px;
  max-width: 480px;
}

.gg-hero__title {
  font-size: 55px;
  margin-bottom: 10px;
}

.gg-hero__desc {
  font-size: 16px;
  margin-bottom: 20px;
}

.gg-hero__btn {
  background: #000;
  color: #fff;
  padding: 12px 22px;
  text-decoration: none;
  font-size: 13px;
  transition: 0.3s;
}

.gg-hero__btn:hover {
  letter-spacing: 2px;
}

/* BOTTOM TEXT */
.gg-bottom {
  text-align: center;
  padding: 12px;
  font-size: 11px;
  letter-spacing: 2px;
  border-top: 1px solid #ddd;
}

/* TABLET */
@media (max-width: 1024px) {
  .gg-hero--desktop {
    height: 420px;
  }

  .gg-hero__content {
    left: 30px;
    bottom: 30px;
  }
}

/* MOBILE */
@media (max-width: 768px) {

  .gg-hero--desktop {
    display: none;
  }

  .gg-hero--mobile {
    display: flex;
    flex-direction: column;
  }

  .gg-topbar {
    grid-template-columns: 1fr 1fr;
    padding: 14px 20px;
  }

  .gg-topbar__tagline {
    display: none;
  }

  /* TEXT TOP */
  .gg-hero__top-text {
    padding: 20px;
    text-align: center;
  }

  .gg-hero__top-text .gg-hero__title {
    font-size: 28px;
  }

  .gg-hero__top-text .gg-hero__desc {
    font-size: 14px;
  }

  /* IMAGE */
  .gg-hero__image-wrap {
    position: relative;
    height: 300px;
  }

  .gg-hero__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* CENTER BUTTON INSIDE IMAGE */
  .gg-hero__btn-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

}

</style>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "text", "id": "logo_text", "label": "Logo", "default": "TISSO VISION" },
    { "type": "text", "id": "tagline_text", "label": "Tagline", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "choose_gift_text", "label": "Button Text", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "choose_gift_link", "label": "Button Link" },
    { "type": "text", "id": "title", "label": "Title", "default": "The Gift Guide" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "text", "id": "button_text", "label": "Shop Button", "default": "SHOP NOW" },
    { "type": "url", "id": "button_link", "label": "Shop Link" },
    { "type": "text", "id": "bottom_text", "label": "Bottom Text" }
  ],
  "presets": [
    { "name": "Gift Guide Banner" }
  ]
}
{% endschema %}