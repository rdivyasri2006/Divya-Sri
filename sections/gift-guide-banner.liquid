<section class="gift-guide-banner">

  <!-- Top Bar -->
  <div class="gg-topbar">
    <span class="gg-topbar__logo">{{ section.settings.logo_text }}</span>
    <span class="gg-topbar__tagline">{{ section.settings.tagline_text }}</span>
    <a href="{{ section.settings.choose_gift_link }}" class="gg-topbar__btn">
      {{ section.settings.choose_gift_text }}
    </a>
  </div>

  <!-- Main Wrapper -->
  <div class="gg-wrapper">

    <!-- LEFT CONTENT -->
    <div class="gg-left">
      <h1 class="gift-guide-banner__title">{{ section.settings.title }}</h1>
      <p class="gift-guide-banner__description">{{ section.settings.description }}</p>
      <a href="{{ section.settings.button_link }}" class="gift-guide-banner__button">
        {{ section.settings.button_text }}
      </a>
    </div>

    <!-- RIGHT IMAGE -->
    <div class="gg-right">
      {% if section.settings.bg_image %}
        <img src="{{ section.settings.bg_image | image_url: width: 900 }}" alt="Banner Image">
      {% endif %}
    </div>

  </div>

  <!-- Bottom Text -->
  <div class="gg-bottom">
    <p>{{ section.settings.bottom_text }}</p>
  </div>

</section>

<style>

.gift-guide-banner {
  background: #f5f5f5;
  font-family: sans-serif;
}

/* Top Bar */
.gg-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 60px;
  border-bottom: 1px solid #ddd;
}

.gg-topbar__logo {
  font-weight: bold;
  text-transform: uppercase;
}

.gg-topbar__btn {
  background: #FFD700;
  padding: 10px 20px;
  text-decoration: none;
  color: black;
  font-weight: bold;
  transition: 0.3s;
}

.gg-topbar__btn:hover {
  transform: translateX(5px);
}

/* Layout */
.gg-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 80px 60px;
}

/* Left */
.gg-left {
  max-width: 420px;
}

.gift-guide-banner__title {
  font-size: 48px;
  font-weight: bold;
  margin-bottom: 16px;
}

.gift-guide-banner__description {
  font-size: 14px;
  margin-bottom: 24px;
  line-height: 1.6;
}

.gift-guide-banner__button {
  background: black;
  color: white;
  padding: 12px 28px;
  text-decoration: none;
  font-weight: bold;
  transition: 0.3s;
}

.gift-guide-banner__button:hover {
  transform: translateX(6px);
}

/* Right Image */
.gg-right img {
  width: 550px;
  max-width: 100%;
  height: auto;
}

/* Bottom */
.gg-bottom {
  text-align: center;
  padding: 12px;
  border-top: 1px solid #ddd;
  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;
}

/* Mobile */
@media (max-width: 768px) {
  .gg-wrapper {
    flex-direction: column;
    text-align: center;
  }

  .gg-right img {
    margin-top: 20px;
  }
}

</style>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Right Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "TISSO VISION"
    },
    {
      "type": "text",
      "id": "tagline_text",
      "label": "Tagline",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "choose_gift_text",
      "label": "Choose Gift Button",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "choose_gift_link",
      "label": "Choose Gift Link"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Text"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}