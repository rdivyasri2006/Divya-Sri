<section class="gift-guide-banner">

  <!-- Top Bar -->
  <div class="gg-topbar">
    <span class="gg-topbar__logo">{{ section.settings.logo_text }}</span>
    <span class="gg-topbar__tagline">{{ section.settings.tagline_text }}</span>
    <a href="{{ section.settings.choose_gift_link }}" class="gg-topbar__btn">
      {{ section.settings.choose_gift_text }} &rarr;
    </a>
  </div>

  <!-- Hero Area -->
  <div class="gg-hero">
    {% if section.settings.bg_image %}
      <img 
        src="{{ section.settings.bg_image | image_url: width: 1400 }}" 
        alt="Banner Background" 
        class="gg-hero__bg-img"
      >
    {% endif %}

    <div class="gg-hero__content">
      <h1 class="gg-hero__title">{{ section.settings.title }}</h1>
      <p class="gg-hero__desc">{{ section.settings.description }}</p>
      <a href="{{ section.settings.button_link }}" class="gg-hero__btn">
        {{ section.settings.button_text }} &rarr;
      </a>
    </div>
  </div>

  <!-- Bottom Text -->
  <div class="gg-bottom">
    <p>{{ section.settings.bottom_text }}</p>
  </div>

</section>

<style>

* { box-sizing: border-box; }

.gift-guide-banner {
  font-family: sans-serif;
  background: #fff;
  width: 100%;
}

/* Top Bar */
.gg-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 40px;
  border-bottom: 1px solid #ddd;
  background: #fff;
}

.gg-topbar__logo {
  font-weight: 700;
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #000;
}

.gg-topbar__tagline {
  font-size: 13px;
  color: #444;
}

.gg-topbar__btn {
  background: #FFD700;
  padding: 10px 20px;
  text-decoration: none;
  color: #000;
  font-weight: 700;
  font-size: 13px;
  transition: letter-spacing 0.3s ease;
}

.gg-topbar__btn:hover {
  letter-spacing: 2px;
}

/* Hero */
.gg-hero {
  position: relative;
  width: 100%;
  min-height: 420px;
  overflow: hidden;
  background: #f5f5f5;
}

.gg-hero__bg-img {
  position: absolute;
  top: 0;
  right: 0;
  width: 65%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

/* White fade over image so left text is readable */
.gg-hero::after {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 55%;
  height: 100%;
  background: linear-gradient(to right, #f5f5f5 70%, transparent);
  z-index: 1;
}

.gg-hero__content {
  position: relative;
  z-index: 2;
  padding: 60px 40px;
  max-width: 400px;
}

.gg-hero__title {
  font-size: 46px;
  font-weight: 900;
  line-height: 1.1;
  margin: 0 0 16px;
  color: #000;
}

.gg-hero__desc {
  font-size: 13px;
  line-height: 1.7;
  color: #333;
  margin: 0 0 28px;
}

.gg-hero__btn {
  display: inline-block;
  background: #000;
  color: #fff;
  padding: 13px 28px;
  font-weight: 700;
  font-size: 13px;
  text-decoration: none;
  transition: letter-spacing 0.3s ease;
}

.gg-hero__btn:hover {
  letter-spacing: 2px;
}

/* Bottom */
.gg-bottom {
  text-align: center;
  padding: 10px;
  border-top: 1px solid #ddd;
  font-size: 10px;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: #555;
}

/* Mobile */
@media (max-width: 768px) {
  .gg-topbar {
    padding: 12px 20px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .gg-topbar__tagline {
    display: none;
  }

  .gg-hero {
    min-height: auto;
  }

  .gg-hero__bg-img {
    position: relative;
    width: 100%;
    height: 220px;
    top: auto;
    right: auto;
  }

  .gg-hero::after {
    display: none;
  }

  .gg-hero__content {
    padding: 30px 20px;
    max-width: 100%;
    text-align: center;
  }

  .gg-hero__title {
    font-size: 32px;
  }
}

</style>