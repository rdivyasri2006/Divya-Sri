<section class="gift-guide-banner">

  <!-- Top Bar -->
  <div class="gg-topbar">
    <span class="gg-topbar__logo">{{ section.settings.logo_text }}</span>
    <span class="gg-topbar__tagline">{{ section.settings.tagline_text }}</span>
    <a href="{{ section.settings.choose_gift_link }}" class="gg-topbar__btn">
      {{ section.settings.choose_gift_text }} &rarr;
    </a>
  </div>

  <!-- Hero Area with background illustration -->
  <div class="gg-hero" {% if section.settings.bg_image %}style="background-image: url('{{ section.settings.bg_image | image_url: width: 1400 }}');"{% endif %}>
    <div class="gg-hero__content">
      <h1 class="gg-hero__title">{{ section.settings.title }}</h1>
      <p class="gg-hero__desc">{{ section.settings.description }}</p>
      <a href="{{ section.settings.button_link }}" class="gg-hero__btn">
        {{ section.settings.button_text }} &rarr;
      </a>
    </div>
  </div>

  <!-- Bottom Text -->
  <div class="gg-bottom">
    <p>{{ section.settings.bottom_text }}</p>
  </div>

</section>

<style>
.gift-guide-banner {
  background: #fff;
  font-family: sans-serif;
}

/* ── Top Bar ── */
.gg-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 40px;
  border-bottom: 1px solid #e0e0e0;
}

.gg-topbar__logo {
  font-weight: 700;
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.gg-topbar__tagline {
  font-size: 13px;
  color: #444;
}

.gg-topbar__btn {
  background: #FFD700;
  padding: 10px 20px;
  text-decoration: none;
  color: #000;
  font-weight: 700;
  font-size: 13px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: letter-spacing 0.3s ease;
}

.gg-topbar__btn:hover {
  letter-spacing: 2px;
}

/* ── Hero ── */
.gg-hero {
  position: relative;
  min-height: 420px;
  background-size: cover;
  background-position: center right;
  background-repeat: no-repeat;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
}

/* dark-to-transparent gradient so text stays readable */
.gg-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to right, rgba(255,255,255,0.92) 38%, rgba(255,255,255,0) 70%);
}

.gg-hero__content {
  position: relative;
  z-index: 1;
  padding: 60px 40px;
  max-width: 420px;
}

.gg-hero__title {
  font-size: 46px;
  font-weight: 900;
  line-height: 1.1;
  margin: 0 0 16px;
}

.gg-hero__desc {
  font-size: 13px;
  line-height: 1.7;
  color: #333;
  margin: 0 0 28px;
}

.gg-hero__btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #000;
  color: #fff;
  padding: 13px 28px;
  font-weight: 700;
  font-size: 13px;
  text-decoration: none;
  transition: letter-spacing 0.3s ease;
}

.gg-hero__btn:hover {
  letter-spacing: 2px;
}

/* ── Bottom Bar ── */
.gg-bottom {
  text-align: center;
  padding: 10px;
  border-top: 1px solid #e0e0e0;
  font-size: 10px;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: #555;
}

/* ── Mobile ── */
@media (max-width: 768px) {
  .gg-topbar {
    padding: 12px 20px;
  }

  .gg-topbar__tagline {
    display: none;
  }

  .gg-hero {
    min-height: 320px;
    background-position: center;
  }

  .gg-hero::before {
    background: rgba(255,255,255,0.80);
  }

  .gg-hero__content {
    padding: 40px 20px;
    max-width: 100%;
    text-align: center;
  }

  .gg-hero__title {
    font-size: 32px;
  }
}
</style>