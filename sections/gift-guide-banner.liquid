<section class="gift-guide-banner" style="background-color: {{ section.settings.bg_color }}">
  <div class="gg-topbar">
    <span class="gg-topbar__logo">{{section.settings.logo_text}}</span>
    <span class="gg-topbar__tagline">{{section.settings.tagline_text}}</span>
    <a href="#" class="gg-topbar__btn">{{section.settings.choose_gift_text}}<span class="gg-arrow">→</span></a>
  </div>
  <div class="gift-guide-banner__content">
    <h1 class="gift-guide-banner__title">{{ section.settings.title }}</h1>
    <p class="gift-guide-banner__description">{{ section.settings.description }}</p>
    <a href="{{ section.settings.button_link }}" class="gift-guide-banner__button">
      {{ section.settings.button_text }}
    </a>
  </div>
  <div class="gg-ticker">
    <div class="gg-ticker__track">
      <span>{{section.settings.ticker_text}}</span>
      <span>{{section.settings.ticker_text}}</span>
      <span>{{section.settings.ticker_text}}</span>
    </div>
  </div>
      
</section>

<style>
  .gift-guide-banner {
    position: relative;
    padding: 60px 40px;
    min-height: 400px;
    display: flex;
    align-items: center;
    background-image: url('{{ section.settings.bg_image | img_url: "master" }}');
    background-size: cover;
    background-position: center;
  }
  .gift-guide-banner__content {
    max-width: 500px;
  }
  .gift-guide-banner__title {
    font-size: 48px;
    font-weight: bold;
    margin-bottom: 16px;
    color: {{ section.settings.text_color }};
  }
  .gift-guide-banner__description {
    font-size: 16px;
    margin-bottom: 24px;
    color: {{ section.settings.text_color }};
  }
  .gift-guide-banner__button {
    display: inline-block;
    padding: 12px 32px;
    background-color: {{ section.settings.button_color }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    font-weight: bold;
  }
  .gg-ticker{
    overflow:hidden;
    border-top:1px solid #000;
    padding:8px 0;
    background:#fff;
  }
  .gg-ticker__track{
    display:flex;
    white-space:nowrap;
    animation:tickerScroll 18s linear infinite;
  }
  .gg-ticker__track span{
    font-size:11px;
    font-weight:600;
    letter-spacing:2px;
    text-transform:uppercase;
    padding-right:60px;
  }
  @keyframes tickerScroll{
    0%{transform:translateX(0);}
    100%{transform:translateX(-33.33%);}
  }
</style>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f5f5"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Find the perfect gift for everyone on your list"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type":"text",
      "id":"ticker_text",
      "label":"Ticker Text",
      "default":"SUSTAINABLE,ETHICALLY MADE CLOTHES IN SIZE XXS TO 4XL"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}